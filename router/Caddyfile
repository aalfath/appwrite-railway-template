# Public entry point of the Appwrite stack.
# Upstreams (host:port on Railway's private network) come from the service variables
# APPWRITE_API, APPWRITE_REALTIME and APPWRITE_CONSOLE.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# Only Railway's edge reaches this service from outside, so keep the
		# X-Forwarded-For / X-Forwarded-Proto it sets and pass them on.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:8080} {
	handle /__router/health {
		respond "OK" 200
	}

	handle /v1/realtime* {
		reverse_proxy {$APPWRITE_REALTIME}
	}

	@api path /v1 /v1/* /.well-known/*
	handle @api {
		reverse_proxy {$APPWRITE_API}
	}

	handle {
		reverse_proxy {$APPWRITE_CONSOLE}
	}
}
